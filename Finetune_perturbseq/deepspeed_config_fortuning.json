{
  "zero_optimization": {
    "stage": 2,
    "offload_optimizer": {
      "device": "cpu",
      "pin_memory": true
    },
    "memory_efficient_linear": false
  },
  "bf16": {
    "enabled": true
  },
  "train_micro_batch_size_per_gpu": 4,
  "gradient_accumulation_steps": 5,
  "optimizer": {
    "type": "AdamW",
    "params": {
      "lr": 5e-5,
      "weight_decay": 1e-3,
      "betas": [0.9, 0.999]
    }
  },
  "scheduler": {
    "type": "WarmupDecayLR",
    "params": {
      "warmup_min_lr": 0,
      "warmup_max_lr": 1e-4,
      "warmup_num_steps": 100,
      "total_num_steps": 10000
    }
  }
}
